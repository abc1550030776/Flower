###############################################################################
# Bazel now uses Bzlmod by default to manage external dependencies.
# Please consider migrating your external dependencies from WORKSPACE to MODULE.bazel.
#
# For more details, please check https://github.com/bazelbuild/bazel/issues/18958
###############################################################################
module(
    name = "flower",
    version = "0.1.0",
)

# Bazel C++ rules（几乎所有 C++ 项目都需要）
bazel_dep(name = "rules_cc", version = "0.2.9")

############################
# abseil-cpp（原 http_archive）
############################
bazel_dep(
    name = "abseil-cpp",
    version = "20260107.0",  # 稳定可用版本
)

############################
# protobuf（覆盖 tcmalloc 依赖的旧版本，使其兼容 Bazel 9）
############################
bazel_dep(name = "protobuf", version = "34.0.bcr.1", repo_name = "com_google_protobuf")

############################
# tcmalloc（从 GitHub 远程拉取）
############################
bazel_dep(name = "tcmalloc")
git_override(
    module_name = "tcmalloc",
    remote = "https://github.com/google/tcmalloc.git",
    commit = "068dd9e9f1337556c55fe5d2e994030b4449548d",
)
